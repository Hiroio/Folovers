rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ---------------------------------------------------------------------
    // Users/{uid}
    // ---------------------------------------------------------------------
    match /Users/{userId} {
      // Any signed-in user can look someone up - profiles, connections,
      // mail senders, "Unknown User" fallback all rely on this
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;

      match /todos/{todoId} {
        // A stranger sees it only if the todo itself is public AND the
        // owner hasn't turned the whole list off (todoPrivacy, default visible)
        allow read: if isSignedIn() &&
          (request.auth.uid == userId ||
            (resource.data.privacy == 'public' &&
             get(/databases/$(database)/documents/Users/$(userId)).data.get('todoPrivacy', true) != false));
        allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // ---------------------------------------------------------------------
    // Folders/{folderId}  (+ Plans subcollection)
    // ---------------------------------------------------------------------
    match /Folders/{folderId} {
      allow read, update, delete: if isSignedIn() &&
        request.auth.uid in resource.data.members;
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.members;

      match /Plans/{planId} {
        allow read, create, update, delete: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/Folders/$(folderId)).data.members;
      }
    }

    // ---------------------------------------------------------------------
    // Connections/{connectionId}  (id = sorted uid pair)
    // ---------------------------------------------------------------------
    match /Connections/{connectionId} {
      allow read, update, delete: if isSignedIn() &&
        request.auth.uid in resource.data.users;
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.users;
    }

    // ---------------------------------------------------------------------
    // Mails/{mailId}
    // ---------------------------------------------------------------------
    match /Mails/{mailId} {
      allow read, update, delete: if isSignedIn() &&
        (request.auth.uid == resource.data.createdBy || request.auth.uid == resource.data.createdFor);
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.createdBy;
    }
  }
}
